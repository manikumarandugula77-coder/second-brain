# OS files
.DS_Store
Thumbs.db

# Obsidian - ignore themes and icons
.obsidian/themes/
.obsidian/icons/

# Obsidian Cache (not needed in repo)
.obsidian/cache/

# Allow obsidian-git plugin (required for sync) but ignore other plugins
# Gitignore negation: re-include the directory, then specific plugin contents
!.obsidian/plugins/
!.obsidian/plugins/obsidian-git/
!.obsidian/plugins/obsidian-git/*
!.obsidian/plugins/obsidian-git/**/*
# Ignore all other plugins
.obsidian/plugins/*
!.obsidian/plugins/obsidian-git
!.obsidian/plugins/obsidian-git/
!.obsidian/plugins/obsidian-git/*
!.obsidian/plugins/obsidian-git/**/*

# Hermes Workspace - Sensitive Files
hermes-workspace/config/.env
hermes-workspace/**/.env
hermes-workspace/**/__pycache__/
hermes-workspace/**/node_modules/
hermes-workspace/**/venv/
hermes-workspace/**/.venv/
hermes-workspace/**/data/*.db
hermes-workspace/**/data/*.sqlite
hermes-workspace/logs/*.log

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Node.js
node_modules/

# Temporary
*.tmp
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
